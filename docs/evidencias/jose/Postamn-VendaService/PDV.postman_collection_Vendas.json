            "exec": [
              "pm.test(\"Status deve ser 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Não redirecionou para tela de login\", function () {\r\n    pm.expect(pm.response.text()).to.not.include(\"PDV - Login\");\r\n});\r\n\r\npm.test(\"Página contém o valor da venda (6,50)\", function () {\r\n    pm.expect(pm.response.text()).to.include(\"6,50\");\r\n});"
            ]
          }
        }
