    {
      "name": "01 - LOGIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Verifica se o cookie JSESSIONID existe na resposta\r\nvar sessionCookie = pm.cookies.get(\"JSESSIONID\");\r\n\r\nif (sessionCookie) {\r\n    // Salva o valor do cookie na variável global 'meu_cookie'\r\n    pm.globals.set(\"meu_cookie\", sessionCookie);\r\n    console.log(\"Cookie salvo automaticamente: \" + sessionCookie);\r\n}"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "gerente"
            },
            {
              "key": "password",
              "value": "123"
            }
          ]
        },
        "url": {
          "raw": "http://127.0.0.1:8081/login",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "8081",
