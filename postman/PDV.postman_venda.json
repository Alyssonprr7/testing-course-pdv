    {
      "name": "02- Abrir venda",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status deve ser 302 Found\", function () {\r\n    pm.response.to.have.status(302);\r\n});\r\n\r\nvar locationHeader = pm.response.headers.get(\"Location\");\r\nif (locationHeader) {\r\n    var partes = locationHeader.split(\"/\");\r\n    var idVenda = partes[partes.length - 1];\r\n    \r\n    // Guarda o ID automaticamente numa variável global/ambiente\r\n    pm.globals.set(\"id_venda_atual\", idVenda);\r\n    console.log(\"ID capturado: \" + idVenda);\r\n}"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "JSESSIONID={{meu_cookie}}"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "observacao",
              "value": "Venda de Integraçao API"
            },
            {
              "key": "pessoa",
              "value": "1"
            }
          ]
        },
        "url": {
          "raw": "http://127.0.0.1:8081/venda",
