{
  "info": {
    "name": "PDV - Recebimento",
    "description": "Testes de integração do recebimento de parcelas (RecebimentoService). Antes de rodar, aplique src/test/resources/sql/recebimento-massa.sql e deixe nenhum caixa do tipo CAIXA aberto. Rodar na ordem. O request marcado com [BUG] falha de propósito.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// O sistema só aceita usuário logado: faz login antes de cada request.",
          "pm.sendRequest({",
          "    url: pm.collectionVariables.get(\"baseUrl\") + \"/login\",",
          "    method: \"POST\",",
          "    header: { \"Content-Type\": \"application/x-www-form-urlencoded\" },",
          "    body: {",
          "        mode: \"urlencoded\",",
          "        urlencoded: [",
          "            { key: \"username\", value: pm.collectionVariables.get(\"usuario\") },",
          "            { key: \"password\", value: pm.collectionVariables.get(\"senha\") }",
          "        ]",
          "    }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Abrir CAIXA com 100,00 (preparação)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Caixa aberto\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"/caixa/gerenciar/\");",
              "});",
              "",
              "// a resposta termina com o código do caixa: \"...gerenciar/]}15\"",
              "pm.collectionVariables.set(\"caixaId\", pm.response.text().split(\"}\")[1]);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/caixa",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "caixa"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "descricao",
              "value": "Caixa Postman Recebimento",
              "type": "text"
            },
            {
              "key": "tipo",
              "value": "CAIXA",
              "type": "text"
            },
            {
              "key": "valor_abertura",
              "value": "100,00",
              "type": "text"
            },
            {
              "key": "agencia",
              "value": "",
              "type": "text"
            },
            {
              "key": "conta",
              "value": "",
              "type": "text"
            }
          ]
        }
      }
    },
    {
