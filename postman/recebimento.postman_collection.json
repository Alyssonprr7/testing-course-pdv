              "pm.test(\"Resposta traz o código do recebimento\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"/recebimento/\");",
              "});",
              "",
              "// a resposta termina com o código: \"{Location=[...recebimento/]}15\"",
              "pm.collectionVariables.set(\"recTotal\", pm.response.text().split(\"}\")[1]);"
