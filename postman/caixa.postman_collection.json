{
  "info": {
    "name": "PDV - POST /caixa",
    "description": "Testes de integração da abertura de caixa (CaixaService.cadastro). Rodar na ordem.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "usuario",
      "value": "gerente"
    },
    {
      "key": "senha",
      "value": "123"
    },
    {
      "key": "caixaId",
      "value": ""
    },
    {
      "key": "cofreId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// O sistema só aceita usuário logado: faz login antes de cada request.",
          "pm.sendRequest({",
          "    url: pm.collectionVariables.get(\"baseUrl\") + \"/login\",",
          "    method: \"POST\",",
          "    header: { \"Content-Type\": \"application/x-www-form-urlencoded\" },",
          "    body: {",
          "        mode: \"urlencoded\",",
          "        urlencoded: [",
          "            { key: \"username\", value: pm.collectionVariables.get(\"usuario\") },",
          "            { key: \"password\", value: pm.collectionVariables.get(\"senha\") }",
          "        ]",
          "    }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Abrir CAIXA com 100,00",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Resposta traz o código do caixa\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"/caixa/gerenciar/\");",
              "});",
              "",
              "// a resposta termina com o código do caixa: \"...gerenciar/]}15\"",
              "const codigo = pm.response.text().split(\"}\")[1];",
              "pm.collectionVariables.set(\"caixaId\", codigo);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/caixa",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "caixa"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "descricao",
              "value": "Caixa Postman",
              "type": "text"
            },
            {
              "key": "tipo",
              "value": "CAIXA",
              "type": "text"
            },
            {
              "key": "valor_abertura",
              "value": "100,00",
              "type": "text"
            },
            {
              "key": "agencia",
              "value": "",
              "type": "text"
            },
            {
              "key": "conta",
              "value": "",
              "type": "text"
            }
          ]
        }
      }
    },
    {
      "name": "02 - Conferir o CAIXA aberto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Saldo total é 100,00\", function () {",
              "    pm.expect(pm.response.text()).to.match(/id=\"valorTotal\"[^>]*value=\"100,00\"/);",
              "});",
              "",
              "pm.test(\"Lançamento de abertura foi criado\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"Abertura de caixa\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/caixa/gerenciar/{{caixaId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "caixa",
            "gerenciar",
            "{{caixaId}}"
          ]
        }
      }
    },
